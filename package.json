		"reshaped": "2.3.0",
		"style-loader": "3.3.2",
		"stylelint": "15.7.0",
		"stylelint-config-prettier": "9.0.5",
		"stylelint-config-standard": "33.0.0",
		"typescript": "5.1.3",
